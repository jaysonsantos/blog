---
import Base from "../../layouts/Base.astro";
import { tagPath } from "../../lib/paths.ts";
import { getPosts, groupByTag } from "../../lib/posts.ts";

const byTag = groupByTag(await getPosts());
---

<Base title="Tags" description="Every tag on the blog.">
  <h1>Tags</h1>
  <ul class="tags">
    {
      [...byTag].map(([tag, posts]) => (
        <li>
          <a href={tagPath(tag)}>#{tag}</a> <span class="count">({posts.length})</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }
  .count {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
