---
import { tagPath } from "../lib/paths.ts";

interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={tagPath(tag)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--accent);
  }
</style>
