---
import { AUTHOR_NAME, LINKS } from "../consts.ts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>© {year} {AUTHOR_NAME}</p>
  <p class="links">
    <a href={LINKS.github} rel="me">GitHub</a>
    <a href={LINKS.x} rel="me">X</a>
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 4rem;
    padding-block: 1.5rem 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
  p {
    margin: 0;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: inherit;
  }
</style>
