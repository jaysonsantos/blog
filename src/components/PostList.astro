---
import { postPath } from "../lib/paths.ts";
import type { Post } from "../lib/posts.ts";
import FormattedDate from "./FormattedDate.astro";
import TagList from "./TagList.astro";

interface Props {
  posts: readonly Post[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <article>
          <h2>
            <a href={postPath(post.id)}>{post.data.title}</a>
          </h2>
          <p class="meta">
            <FormattedDate date={post.data.pubDate} />
          </p>
          <p class="description">{post.data.description}</p>
          <TagList tags={post.data.tags} />
        </article>
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--accent);
  }
  .meta {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .description {
    margin: 0 0 0.5rem;
  }
</style>
