root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
# Code blocks in posts keep the tabs of their language, and list items indent by their marker.
indent_style = unset
indent_size = unset
